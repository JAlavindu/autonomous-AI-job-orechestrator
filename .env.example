# Copy this file to `.env` and adjust for your environment.
# `.env` is gitignored; this file is the committed template.

# --- PostgreSQL (durable source of truth) ---
DATABASE_URL=postgresql+psycopg2://orchestrator:orchestrator@localhost:5432/orchestrator
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_TENANT_NAME=default

# --- Redis (temporary Phase 1A queue/cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Scheduler ---
# "heuristic" = deterministic EDF (default, safe for production)
# "ai"        = use loaded DQN policy with heuristic fallback
SCHEDULER_MODE=heuristic

# --- Executors (comma-separated payload "type" values) ---
# shell/python are dangerous (RCE) - off by default
# Dev example: EXECUTOR_ALLOWLIST=sleep,shell
EXECUTOR_ALLOWLIST=sleep

# --- RL model (offline training output) ---
RL_MODEL_PATH=ai_brain.pth

# --- Logging ---
LOG_LEVEL=INFO

# --- API (optional overrides; rarely changed) ---
# PROJECT_NAME=Autonomous AI Job Orchestrator
# API_V1_STR=/api/v1

# Docker Compose: set REDIS_HOST=redis and DATABASE_URL with host `postgres`.

JOB_STREAM_KEY=stream:jobs
JOB_STREAM_GROUP=workers
JOB_STREAM_BLOCK_MS=5000
JOB_STREAM_MAXLEN=10000