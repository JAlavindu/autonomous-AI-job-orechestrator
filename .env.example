# Copy this file to `.env` and adjust for your environment.
# `.env` is gitignored; this file is the committed template.

# --- Redis (job state + queue) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Scheduler ---
# "heuristic" = deterministic EDF (default, safe for production)
# "ai"        = use loaded DQN policy with heuristic fallback
SCHEDULER_MODE=heuristic

# --- Executors (comma-separated payload "type" values) ---
# shell/python are dangerous (RCE) — off by default
# Dev example: EXECUTOR_ALLOWLIST=sleep,shell
EXECUTOR_ALLOWLIST=sleep

# --- RL model (offline training output) ---
# Note: scheduler currently loads "ai_brain.pth" at repo root;
# RL_MODEL_PATH is defined for future wiring.
RL_MODEL_PATH=rl_engine/checkpoints/model.pth

# --- API (optional overrides; rarely changed) ---
# PROJECT_NAME=Autonomous AI Job Orchestrator
# API_V1_STR=/api/v1